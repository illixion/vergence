{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vergence",
  "mainBinaryName": "Vergence",
  "identifier": "com.illixion.vergence.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vergence",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "AI 3D for your videos, and analysis for your headset",
    "longDescription": "Turns any 2D video into an AI 3D side-by-side copy that 3D players read, and runs the Vergence analysis coordinator and a worker for Jellyfin and Stash libraries, so a headset gets Smooth Motion and depth made on this computer.",
    "copyright": "MIT licensed",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
